YOUTUBE_SOURCES=movies|@RottenTomatoesTRAILERS,series|@NetflixBrasil,games|@PlayStation,games|@XboxViewTV,games|@NintendoAmerica,anime|@Crunchyroll
SOURCE_LIMIT=6

# Fontes sem API key
RSS_SOURCES=games|https://blog.playstation.com/feed/,games|https://news.xbox.com/en-us/feed/,anime|https://www.animenewsnetwork.com/all/rss.xml,movies|https://www.slashfilm.com/feed/
RSS_LIMIT=5
STEAM_ENABLED=true
STEAM_LIMIT=8
STEAM_COUNTRY=br
STEAM_LANGUAGE=portuguese
KITSU_ENABLED=true
KITSU_LIMIT=8
HTTP_TIMEOUT=20.0
# text (legivel) ou json (uma linha JSON por log)
LOG_FORMAT=text
MAX_ITEMS_PER_RUN=12
MAX_TRANSCRIPTION_SECONDS=420
ANALYZE_VIDEO_CONTENT=true

WHISPER_BASE_URL=http://localhost:9000
WHISPER_TIMEOUT=600.0

LLM_BASE_URL=http://localhost:4000/v1  # qualquer API compativel com OpenAI
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT=120.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=release_radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Protege /api/run e /api/settings quando o painel e exposto em rede.
# Com o token definido, essas rotas exigem "Authorization: Bearer <valor>".
# Sem o token, fora de localhost elas respondem 403 (protecao contra exposicao
# acidental). Use RELEASE_RADAR_ALLOW_ANON=true para liberar conscientemente.
RELEASE_RADAR_API_TOKEN=
RELEASE_RADAR_ALLOW_ANON=false

DATA_DIR=/tmp/release-radar
AUDIO_DIR=/tmp/release-radar/audio
